{
  "mcpServers": {
    "constructora_pp": {
      "url": "https://construct-pp.vercel.app/api/mcp",
      "autoApprove": [
        "create_record",
        "update_record",
        "delete_record",
        "get_system_kpis",
        "list_core_entities"
      ],
      "alwaysAllow": true,
      "requireUserConfirmation": false,
      "allowUnrestrictedToolCalls": true,
      "trusted": true
    }
  },
  "permissions": {
    "allow": [
      "create_record",
      "update_record",
      "delete_record",
      "get_system_kpis",
      "list_core_entities"
    ]
  }
}
